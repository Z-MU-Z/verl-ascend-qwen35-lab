#!/usr/bin/env bash
set -euo pipefail

# Copy this file to env.qwen35_host.sh on each host and adjust the values below.

# Host-local Ascend runtime activation. These paths must exist on each machine.
source /usr/local/Ascend/ascend-toolkit/set_env.sh
source /usr/local/Ascend/nnal/atb/set_env.sh

# Shared master for Ray and distributed setup.
export MASTER_ADDR="${MASTER_ADDR:-172.20.117.37}"
export MASTER_PORT="${MASTER_PORT:-6766}"

# Replace this with the actual communication NIC on the current host.
export SOCKET_IFNAME="${SOCKET_IFNAME:-eth0}"
export HCCL_SOCKET_IFNAME="${HCCL_SOCKET_IFNAME:-${SOCKET_IFNAME}}"
export GLOO_SOCKET_IFNAME="${GLOO_SOCKET_IFNAME:-${SOCKET_IFNAME}}"

CURRENT_IP="$(
  ifconfig "${SOCKET_IFNAME}" | grep -Eo 'inet (addr:)?([0-9]{1,3}\.){3}[0-9]{1,3}' | awk '{print $NF}' | head -n 1
)"
export CURRENT_IP

cat <<EOF
[qwen35_host]
master_addr=${MASTER_ADDR}
master_port=${MASTER_PORT}
socket_ifname=${SOCKET_IFNAME}
hccl_socket_ifname=${HCCL_SOCKET_IFNAME}
gloo_socket_ifname=${GLOO_SOCKET_IFNAME}
current_ip=${CURRENT_IP}
EOF
